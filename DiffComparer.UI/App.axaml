<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiffComparer.UI.App"
             xmlns:local="using:DiffComparer.UI"
             RequestedThemeVariant="Default">

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#415F91" />
                <ColorPaletteResources x:Key="Dark" Accent="#AAC7FF" />
            </FluentTheme.Palettes>
        </FluentTheme>

		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
	    <StyleInclude Source="avares://DiffComparer.UI/Styles/Material.axaml" />
	</Application.Styles>
</Application>
