<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiffComparer.UI.ViewModels"
        xmlns:core="using:DiffComparer.Core"
        xmlns:converters="using:DiffComparer.UI.Converters"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="DiffComparer.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DiffComparer"
        Width="1200" Height="700"
        Background="#1e1e1e">

	<Window.Resources>
		<converters:StatusToColorConverter x:Key="StatusToColor"/>
		<converters:WordChangedToColorConverter x:Key="WordChangedToColor"/>
	</Window.Resources>

	<DockPanel>

		<!-- Toolbar -->
		<StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="10,8,10,8">

			<Button Content="Abrir izquierda"
                    Command="{Binding OpenLeftFileCommand}"
                    IsVisible="{Binding IsEditMode}"/>

			<Button Content="Abrir derecha"
                    Command="{Binding OpenRightFileCommand}"
                    IsVisible="{Binding IsEditMode}"/>

			<Button Content="↑ Cambio"
                    Command="{Binding PreviousChangeCommand}"
                    IsVisible="{Binding !IsEditMode}"/>

			<Button Content="↓ Cambio"
                    Command="{Binding NextChangeCommand}"
                    IsVisible="{Binding !IsEditMode}"/>

			<Button Content="Comparar"
                    Command="{Binding CompareCommand}"
                    IsVisible="{Binding IsEditMode}"
                    IsEnabled="{Binding !IsComparing}"/>

			<Button Content="Editar"
                    Command="{Binding EditCommand}"
                    IsVisible="{Binding !IsEditMode}"/>

			<Button Content="Cancelar"
                    Command="{Binding CompareCancelCommand}"
                    IsVisible="{Binding IsComparing}"
                    Margin="8,0,0,0"/>

			<TextBlock Text="Comparando..."
                       IsVisible="{Binding IsComparing}"
                       VerticalAlignment="Center"
                       Foreground="Gray"/>

			<TextBlock Text="{Binding StatsText}"
                       IsVisible="{Binding !IsEditMode}"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Margin="16,0,0,0"/>

		</StackPanel>

		<!-- Paneles principales -->
		<Grid ColumnDefinitions="*,4,*"
			  Margin="10,0,10,10">

			<edit:TextEditor Name="LeftEditor"
							 Grid.Column="0"
							 IsReadOnly="False"
							 Focusable="True"
							 FontFamily="Cascadia Code,Consolas,monospace"
							 FontSize="13"
							 Background="#1e1e1e"
							 Foreground="White"
							 ShowLineNumbers="True"
							 HorizontalScrollBarVisibility="Auto"
							 VerticalScrollBarVisibility="Auto"/>

			<Rectangle Grid.Column="1"
					   Fill="#333333"/>

			<edit:TextEditor Name="RightEditor"
							 Grid.Column="2"
							 IsReadOnly="False"
							 Focusable="True"
							 FontFamily="Cascadia Code,Consolas,monospace"
							 FontSize="13"
							 Background="#1e1e1e"
							 Foreground="White"
							 ShowLineNumbers="True"
							 HorizontalScrollBarVisibility="Auto"
							 VerticalScrollBarVisibility="Auto"/>

		</Grid>
	</DockPanel>
</Window>